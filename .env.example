# Robinhood Chain — verified values, see docs/data-sources.md for sources.
ROBINHOOD_CHAIN_ID=4663
# Public RPC is rate-limited and non-archive; use a dedicated provider (e.g.
# Alchemy robinhood-mainnet.g.alchemy.com) in production.
ROBINHOOD_CHAIN_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Uniswap factories (verified 2026-07-10, developers.uniswap.org).
# Start blocks: V2 = first PairCreated event; V3 = factory deployment.
UNISWAP_V2_FACTORY_ADDRESS=0x8bcEaA40B9AcdfAedF85AdF4FF01F5Ad6517937f
UNISWAP_V2_FACTORY_START_BLOCK=9486
UNISWAP_V3_FACTORY_ADDRESS=0x1f7d7550B1b028f7571E69A784071F0205FD2EfA
UNISWAP_V3_FACTORY_START_BLOCK=8930

# Allow-listed quote assets (verified 2026-07-10, docs.robinhood.com/chain).
# USDG (Paxos Global Dollar) is the chain's canonical stablecoin; Circle-native
# USDC does not exist on Robinhood Chain. Leave an address empty to disable it.
QUOTE_ASSET_WETH_ADDRESS=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
QUOTE_ASSET_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
QUOTE_ASSET_USDC_ADDRESS=
# VIRTUAL (Virtuals Protocol, the chain's day-one AI-agent launchpad currency).
# Canonical per whitepaper.virtuals.io contract-address page (2026-07-12).
# USD price is chained live through its deepest WETH/USDG pool each pass,
# with a $50k anchor-depth circuit breaker — see docs/data-sources.md.
QUOTE_ASSET_VIRTUAL_ADDRESS=0xc6911796042b15d7Fa4F6CDe69e245DdCd3d9c31

# PostgreSQL connection for the monitoring pipeline. Host-side value; inside
# docker compose the worker/deadman containers override this to point at the
# `postgres` service using POSTGRES_PASSWORD below.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/launch_radar
# Password for the compose-managed Postgres (docker-compose.yml). Required
# when deploying with docker compose; unused for a hand-managed database.
POSTGRES_PASSWORD=

# Worker tuning (optional; defaults shown). Malformed values stop the worker.
DISCOVERY_POLL_INTERVAL_MS=15000
DISCOVERY_CHUNK_SIZE=2000
DISCOVERY_CONFIRMATIONS=0
ENRICHMENT_INTERVAL_MS=60000
# Higher concurrency improves multicall batching (reads issued together
# coalesce into single aggregate3 calls).
ENRICHMENT_CONCURRENCY=5

# Active-set scheduling: full-cadence signal refresh only for pools that are
# recent OR valued inside the watch band; everything else is re-valued on the
# idle lane. Keeps RPC cost proportional to launch activity, not to the
# all-time pool count.
ACTIVE_POOL_MAX_AGE_HOURS=72
# Superset of the $10k–$100k focus band with headroom above the eligibility
# max so a pool at the top of GREEN isn't dropped from scoring on a tick.
WATCH_MIN_FDV_USD=10000
WATCH_MAX_FDV_USD=120000
ENRICHMENT_IDLE_REFRESH_MS=21600000
ENRICHMENT_IDLE_BATCH_LIMIT=400
ACTIVITY_POLL_INTERVAL_MS=30000
ACTIVITY_CHUNK_SIZE=2000
ACTIVITY_CONFIRMATIONS=0
# Swap ingestion is scoped to the active set (recent or watch-band pools).
# The refresh lane re-snapshots active pools whose rolling buyer windows are
# older than this, so windows decay even when a pool stops trading.
ACTIVITY_SNAPSHOT_REFRESH_MS=900000
ACTIVITY_REFRESH_BATCH_LIMIT=400
RISK_POLL_INTERVAL_MS=60000
RISK_STALENESS_MS=21600000
RISK_MAX_SELL_LOSS_BPS=5000

# Tradeability-simulation routes: canonical Uniswap V2 Router02 and V3 QuoterV2
# for Robinhood Chain (developers.uniswap.org deployment pages), on-chain
# verified 2026-07-10 — see docs/data-sources.md "Trade-route periphery".
# Leave an address empty to disable that route; missing routes make the
# simulation report UNKNOWN (never a fabricated PASS).
RISK_V2_ROUTER_ADDRESS=0x89e5DB8B5aA49aA85AC63f691524311AEB649eba
RISK_V3_QUOTER_ADDRESS=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
# Quote notionals (USD, comma-separated) probed for the sell-slippage curve on
# each simulation; measures whether exit depth survives at size, not just at
# the single probe. Sized to the $10k–$100k band: the top probe approximates
# a full exit against a band-floor (~$2.5k-quote) pool.
RISK_SLIPPAGE_CURVE_NOTIONALS_USD=100,500,2000

# Holder distribution + scoring/alert loops (optional; defaults shown).
# Eligibility gates for the $10k–$100k focus band (2026-07-13, see
# docs/scoring-model.md). Safety caps (age, sell loss, concentration) are
# band-independent scoring-model constants and have no env key.
# Eligible FDV window (USD).
ELIGIBILITY_MIN_FDV_USD=10000
ELIGIBILITY_MAX_FDV_USD=100000
# Combined both-sides liquidity floor (USD).
ELIGIBILITY_MIN_TOTAL_LIQUIDITY_USD=5000
# Trusted quote-side liquidity floor (USD) — what an exit actually realizes.
ELIGIBILITY_MIN_QUOTE_LIQUIDITY_USD=2500
# Advisory quality threshold. It never changes eligibility.
ELIGIBILITY_MIN_UNIQUE_BUYERS=15
# Eligibility age floor (minutes). 0 since 2026-07-20: the old 20-minute
# floor excluded most ≥10x runners (median entry age 10 min).
ELIGIBILITY_MIN_AGE_MINUTES=0
# Alert tier bands (USD / buyer counts). RED = early watch, YELLOW = research,
# GREEN = go; score gates (65/80) are scoring-model constants without env keys.
# Bands re-cut 2026-07-20 to the measured 10x sweet spot ($15k-$40k).
# RED early-watch FDV window (full band; "seen, worth watching").
ALERT_RED_MIN_FDV_USD=10000
ALERT_RED_MAX_FDV_USD=100000
# RED QUOTE-liquidity floor (gates on quote side since 2026-07-20).
ALERT_RED_MIN_LIQUIDITY_USD=2500
# RED unique-buyer floor.
ALERT_RED_MIN_UNIQUE_BUYERS=5
# YELLOW research-candidate FDV window (young-runner tier; sim may be UNKNOWN).
ALERT_YELLOW_MIN_FDV_USD=15000
ALERT_YELLOW_MAX_FDV_USD=60000
# YELLOW total-liquidity floor.
ALERT_YELLOW_MIN_LIQUIDITY_USD=8000
# GREEN go-tier FDV window (the measured 10x sweet spot; requires sim PASS).
ALERT_GREEN_MIN_FDV_USD=15000
ALERT_GREEN_MAX_FDV_USD=40000
# GREEN unique-buyer floor.
ALERT_GREEN_MIN_UNIQUE_BUYERS=20
HOLDERS_POLL_INTERVAL_MS=120000
HOLDERS_STALENESS_MS=900000
SCORING_POLL_INTERVAL_MS=60000
ALERT_COOLDOWN_MS=1800000
# Alerts scoring below this are stored/tracked but not delivered. 0 disables.
# 80 on the 2026-07-20 four-component scale (liquidityDepth 35, buyerBreadth
# 25, buyFlow 20, lowCapTilt 20): the precision-tilted operating point,
# measured on the labeled horizon-72 replay (floor 70 -> ~138/day; floor 80
# -> ~11/day at 68% >=10x precision vs 1.7% base). First-week live-volume
# ritual tunes this +/-5 before touching component weights:
#   SELECT date_trunc('day', sent_at), count(*) FROM alerts_sent GROUP BY 1;
ALERT_MIN_SCORE=80
# Additional delivery floor for RED-level (early watch) alerts only; the
# effective RED floor is max(ALERT_MIN_SCORE, ALERT_MIN_SCORE_RED). RED is
# non-actionable by definition and most delivered REDs re-alerted as YELLOW
# within the hour (2026-07-12), so only exceptional early-watch candidates
# page. 0 falls back to ALERT_MIN_SCORE. YELLOW/GREEN are unaffected.
ALERT_MIN_SCORE_RED=75
# Copycat-launch suppression: when a DIFFERENT token with the same normalized
# name (case/punctuation-insensitive) already delivered within this window,
# a new alert only delivers if it outranks the sibling's level (observed
# live 2026-07-12: four distinct "Robin World" contracts alerted within 11
# seconds). Suppressed candidates are still scored and persisted. 0 disables.
ALERT_DUPLICATE_NAME_COOLDOWN_MS=21600000
# Same/lower-level re-alerts after the cooldown must ALSO have improved their
# score by at least this many points ("materially new evidence"). 0 disables.
ALERT_REALERT_MIN_SCORE_DELTA=10
# Chart link base for alert messages; the pool address is appended.
CHART_URL_BASE=https://dexscreener.com/robinhood
# Band-priority scheduling (optional; defaults shown). Expensive signals
# (holders, risk) serve watch-band pools first through a bounded band lane,
# then a bounded backlog lane of young pre-band pools.
HOLDERS_BAND_LIMIT=300
HOLDERS_BACKLOG_LIMIT=50
RISK_BATCH_LIMIT=200
# Quote-liquidity floor (USD) for the holders/risk BAND lanes; 0 disables.
# Estimated FDV is nominal (price x supply, dust pools can report any FDV),
# so band membership alone must not trigger transfer-log walks or trade
# simulations. Pools below the floor cannot pass eligibility (quote >= $2500)
# and stay priced/snapshotted/labeled; only their holder/risk priority drops.
BAND_LANE_MIN_QUOTE_LIQUIDITY_USD=500
# Blocks per eth_getLogs request when scanning holder transfer history.
# Cold scans walk from pool creation to head; a larger span cuts the call
# count proportionally. Raise cautiously; providers cap response sizes.
HOLDERS_SCAN_CHUNK_BLOCKS=2000
# GRAY (shadow) candidates persist their feature vector at most once per this
# interval per token — the calibration dataset for future threshold revision.
SCORING_SHADOW_INTERVAL_MS=3600000

# --- Low-CU profile (optional) ---
# Documented overrides for running on a constrained Alchemy compute-unit
# budget (e.g. after a capacity-limit incident). Each trades data freshness
# for fewer RPC reads; all are reversible per-key. ACTIVE_POOL_MAX_AGE_HOURS
# is the dominant saver — it bounds the per-pass working set; if you change
# only one value, change that one. Uncomment to apply:
#ACTIVE_POOL_MAX_AGE_HOURS=12      # full-cadence active set shrinks; older pools revalue on the idle lane only
#ACTIVITY_POLL_INTERVAL_MS=60000   # halves swap-log scan frequency; swaps still backfill via cursor, coarser snapshots
#ENRICHMENT_INTERVAL_MS=90000      # fewer state-read passes; price/FDV freshness lags ~30s more
#ENRICHMENT_IDLE_REFRESH_MS=43200000   # idle (non-active) pools re-valued every 12h instead of 6h
#ACTIVITY_SNAPSHOT_REFRESH_MS=1800000  # rolling-window decay refresh every 30m instead of 15m
#HOLDERS_POLL_INTERVAL_MS=180000   # fewer holder-scan passes (transfer-log enumeration is CU-heavy)
#HOLDERS_STALENESS_MS=1800000      # holder snapshots refreshed every 30m instead of 15m
#HOLDERS_SCAN_CHUNK_BLOCKS=10000   # 5x fewer getLogs calls per cold holder scan; safe while transfer volume is sparse
#HOLDERS_BAND_LIMIT=100            # fewer holder scans per pass while a cold-scan backlog drains
# Eligibility/alert/score thresholds are product gates, not cost knobs —
# leave them untouched when cutting CU burn.

# Derived-signal tuning (optional; defaults shown).
# Latest quote liquidity below this fraction of observed peak (bps) marks an
# LP pull: the candidate is invalidated (not eligible, capped at GRAY).
LIQUIDITY_COLLAPSE_FRACTION_BPS=2000
# "Early buyer" retention window, minutes from the pool's first stored swap.
RETENTION_WINDOW_MINUTES=60
# Cohort percentiles are withheld below this many same-age peer pools.
COHORT_MIN_SIZE=8

# Realized-performance labeling (optional; defaults shown). For EVERY pool
# whose observed history first crossed into the reference band — alerted or
# not — records entry features and realized max multiple / drawdown / time to
# peak per horizon. Population-wide by design: this is the calibration
# dataset for tuning thresholds, deliberately not conditioned on alerts.
PERFORMANCE_POLL_INTERVAL_MS=3600000
# 24h is the winners-retro's provisional horizon; 72h/168h mature it.
PERFORMANCE_HORIZONS_HOURS=24,72,168
PERFORMANCE_BAND_MIN_FDV_USD=10000
PERFORMANCE_BAND_MAX_FDV_USD=100000
PERFORMANCE_BATCH_LIMIT=200

# Survival-outcome labeling (optional; defaults shown). Labels every observed
# pool SURVIVED/DIED at each horizon to build the calibration dataset.
OUTCOME_POLL_INTERVAL_MS=3600000
OUTCOME_HORIZONS_HOURS=24,72
# SURVIVED requires >= this share of peak quote liquidity (bps) at horizon...
OUTCOME_MIN_LIQUIDITY_FRACTION_BPS=3000
# ...and >= this estimated FDV (USD) at horizon.
OUTCOME_MIN_FDV_USD=10000
OUTCOME_BATCH_LIMIT=200

# Winners retro (optional; defaults shown). Enumerates realized sustained,
# liquidity-adjusted winners among band-crossers, attributes each to the first
# pipeline stage that failed to surface it (coverage tier ladder), and sends
# an event-driven digest when NEW winners appear. Hypothesis generator for
# threshold changes — see docs/execution-methodology.md for the ritual.
WINNERS_RETRO_INTERVAL_MS=3600000
WINNERS_MIN_MULTIPLE_BPS=50000
WINNERS_MIN_EXIT_LIQUIDITY_USD=15000
# Digest destination; falls back to DEADMAN_CHAT_ID, then TELEGRAM_CHAT_ID.
WINNERS_RETRO_CHAT_ID=

# Analytics dashboard (bun run dashboard): read-only local analysis console
# over DATABASE_URL (live DB, the radar-pg scratch container, or a restored
# scripts/backup.sh dump). Binds localhost by default on purpose: there is
# no auth, so never expose it publicly; for a remote box tunnel with
# `ssh -L 4600:localhost:4600`.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4600

# Telegram alerts. Leave BOTH empty to run alerts in DRY-RUN (logged, not sent).
# To go live: message @BotFather on Telegram -> /newbot -> paste the token here;
# then get your chat id (message the bot, then read
# https://api.telegram.org/bot<token>/getUpdates and copy "chat":{"id":...}).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dead-man heartbeat (docker compose `deadman` service; optional; defaults
# shown). Alerts via Telegram when the newest pool snapshot is older than the
# max age — i.e. the worker or its RPC/DB is down. Reminders repeat while
# stale; one recovery message on return to healthy.
DEADMAN_CHECK_INTERVAL_MS=60000
DEADMAN_MAX_SNAPSHOT_AGE_MS=600000
DEADMAN_REMIND_INTERVAL_MS=1800000
# Optional separate chat for dead-man infra pages (same bot). Unset = pages
# go to TELEGRAM_CHAT_ID. Useful when the main chat is a shared group.
DEADMAN_CHAT_ID=

# Operator trading wallet(s), comma-separated (optional). When set, the
# feedback report auto-detects your entries/exits from ingested swaps — no
# manual `decide` needed except for recording PASSED reasons and intent.
OPERATOR_WALLET_ADDRESSES=

# Self-service alert subscriptions are disabled by default. Set a non-empty
# join code to permit a chat to subscribe with `/join <code>`; new chats stay
# PENDING until they send the correct code. Existing ACTIVE chats remain
# active, so remove rows from `telegram_subscriptions` to revoke access.
TELEGRAM_JOIN_CODE=
SUBSCRIPTIONS_POLL_INTERVAL_MS=30000

# Advisory LLM judgment layer (optional; OFF unless both LLM_API_KEY and
# JUDGMENT_MODEL are set — setting only one is a hard configuration error).
# For each LIVE alert at/above JUDGMENT_MIN_ALERT_LEVEL, assembles the same
# as-of evidence an operator would see, asks the LLM for an evidence-bound
# research brief with machine-checked citations, and — only when the brief
# COMPLETED (never on FAILED or a fabricated citation) — sends ONE follow-up
# Telegram message. Advisory only: this never delays, edits, or gates an
# alert, and every call to the LLM API is a real, billed request.
JUDGMENT_POLL_INTERVAL_MS=30000
# YELLOW => briefs YELLOW+GREEN alerts; GREEN => GREEN only; RED => all three.
# (Stoplight tiers since 2026-07-11: RED=early watch, YELLOW=research, GREEN=go.)
JUDGMENT_MIN_ALERT_LEVEL=YELLOW
JUDGMENT_BATCH_LIMIT=5
JUDGMENT_MAX_TOOL_ROUNDS=8
# Per-brief deadline; a brief that blows this budget is recorded FAILED, not
# retried indefinitely.
JUDGMENT_TIMEOUT_MS=90000
# Per-token re-brief suppression: a token whose latest COMPLETED brief is
# younger than this is NOT briefed again for a same/lower-level re-alert —
# only a level escalation (e.g. YELLOW -> GREEN) earns a fresh brief.
# 0 disables (every alert briefs; produces repeat briefs for tokens that
# re-alert on score improvements).
JUDGMENT_REBRIEF_COOLDOWN_MS=86400000
LLM_API_BASE_URL=https://api.openai.com/v1
# Leave BOTH empty to disable the judgment loop entirely (default).
LLM_API_KEY=
JUDGMENT_MODEL=
